      "executeOnce": true,
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "BXpGaetSxxxjbtyY",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const apifyJobs = $('Parse Intermediary').all();\nconst sheetRows = $('Get Seen Jobs (Sheet)').all();\n\nconst seenUrls = new Set(\n  sheetRows.map(r => r.json.URL).filter(Boolean)\n);\n\nconst newJobs = apifyJobs.filter(job => job.json.id !== 'error' && !seenUrls.has(job.json.url));\n\n// Return empty array so n8n stops cleanly without wasting a Groq API call\nif (newJobs.length === 0) {\n  return [];\n}\n\nreturn newJobs;\n"
      },
