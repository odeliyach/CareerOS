      "id": "b710687a-5b89-4506-80f4-fb2ff241252a",
      "name": "Fetch LinkedIn Jobs (Apify)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        -1120,
        96
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet jobs = [];\n\nif (items.length === 1 && Array.isArray(items[0].json)) {\n    jobs = items[0].json;\n} else if (items.length === 1 && items[0].json.items && Array.isArray(items[0].json.items)) {\n    jobs = items[0].json.items;\n} else {\n    jobs = items.map(item => item.json);\n}\n\nif (jobs.length === 0) {\n    return [{json: {id: 'error', company: 'No Data', title: 'No Title', description: 'Empty', url: ''}}];\n}\n\n// רק השורה הבאה השתנתה: הוספתי slice(0, 2) כדי לחתוך אך ורק ל-2 משרות\nreturn jobs.slice(0, 101).map(j => ({\n    json: {\n        id: j.id || j.jobId || Math.random().toString(36).substr(2,9),\n        company: j.company || j.companyName || 'Unknown Company',\n        title: j.title || j.positionName || 'Unknown Title',\n        \n        // התיקון הקריטי: שואב את descriptionText שהאקטור מחזיר!\n        description: j.descriptionText || j.description || j.jobDescription || 'No description found',\n        \n        // התיקון הקריטי השני: שואב את applyUrl או בונה קישור מזהה\n        url: j.applyUrl || j.linkedinUrl || j.url || ('https://www.linkedin.com/jobs/view/' + j.id)\n    }\n}));\n"
      },
      "id": "b4eb2741-7cfb-489d-8cb1-34948cf144cf",
      "name": "Parse Intermediary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -896,
        96
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: 'openai/gpt-oss-120b',\n  reasoning_effort: 'low',\n  response_format: { type: 'json_object' },\n  messages: [\n    {\n      role: 'system',\n      content: 'You evaluate job postings for a Junior or CS Student specializing in Backend (Python/Java/C), Systems Programming, ML, and NLP. \\n\\nTARGET ROLES: Systems Engineer, Backend Developer, ML Engineer, NLP Researcher, AI Engineer, MLOps, Low-level optimization.\\n\\nREJECT AND GIVE A SCORE OF 0 IF:\\n- Job explicitly requires 3+ years of full-time experience.\\n- Pure Frontend/UI/Mobile role.\\n- Text is in a foreign language (not English or Hebrew).\\n- Located strictly outside Israel (unless remote for Israel).\\n\\nOtherwise, score 1-100 based on technical match. Return ONLY JSON: {\"match_score\": number, \"reason\": \"brief evaluation\", \"location\": \"string\", \"experience_level\": \"string\", \"key_requirements\": \"string\"}'\n    },\n    {\n      role: 'user',\n      content: `Job: ${$json.title} at ${$json.company}\\nDesc: ${$json.description}`\n    }\n  ],\n  temperature: 0.1,\n  max_tokens: 2048\n}) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 20000
            }
          }
        }
      },
      "id": "779cea8a-39ef-489b-86ed-08f63e0c071f",
      "name": "Groq Evaluate Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        -672,
        96
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "EV5TtLlrpZapy6WQ",
          "name": "Header Auth account 2"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const groqOut = $input.item.json?.choices?.[0]?.message?.content || '{}';\nlet score = 0;\nlet parsed = {};\n\ntry {\n  parsed = JSON.parse(groqOut.replace(/```json/g, '').replace(/```/g, '').trim());\n  score = Number(parsed.match_score) || 0;\n} catch(e) {}\n\nconst toStr = (val) => {\n  if (val == null) return '';\n  if (Array.isArray(val)) return val.map(v => typeof v === 'object' ? JSON.stringify(v) : String(v)).join(', ');\n  if (typeof val === 'object') return JSON.stringify(val);\n  return String(val);\n};\n\nconst loc = toStr(parsed.location);\n\n// AI Safeguard: if the AI explicitly stated a foreign location (e.g. Denmark) but forgot to set 0, force it\nif (loc && !loc.toLowerCase().includes('israel') && loc.toLowerCase() !== 'remote') {\n  if (loc.toLowerCase().includes('danmark') || loc.toLowerCase().includes('denmark')) {\n    score = 0;\n  }\n}\n\nconst companyName = $('Filter New Jobs Only').item.json.company || 'Unknown';\nconst jobTitle = $('Filter New Jobs Only').item.json.title || 'Unknown';\nconst jobUrl = $('Filter New Jobs Only').item.json.url || '';\n\nconst markdown = \"---\\ncompany: \\\"\" + companyName + \"\\\"\\nrole: \\\"\" + jobTitle + \"\\\"\\nstatus: \\\"lead\\\"\\njob_link: \\\"\" + jobUrl + \"\\\"\\n---\\n\";\n\nreturn { json: {\n  company_name: companyName,\n  job_title: jobTitle,\n  job_url: jobUrl,\n  match_score: score,\n  reason: toStr(parsed.reason),\n  location: loc,\n  experience_level: toStr(parsed.experience_level),\n  requirements: toStr(parsed.key_requirements),\n  applied_date: new Date().toISOString().split('T')[0],\n  file_content_b64: Buffer.from(markdown).toString('base64').replace(/\\s/g, '')\n}};\n"
      },
