    {
      "parameters": {
        "method": "POST",
        "url": "https://api.apify.com/v2/actor-tasks/jR7d0eQ2ghKgGH5dQ/run-sync-get-dataset-items?token=YOUR_APIFY_TOKEN",
        "options": {}
