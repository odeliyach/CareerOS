# Copy this file to .env and fill in your values.
# Never commit .env.

# GitHub fine-grained token with Contents: Read and write on your private data repo
GITHUB_TOKEN=your_github_token_here

# Groq API key (free tier): https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# Encrypts credentials stored in n8n. Generate with: openssl rand -hex 32
# Changing it later makes previously saved credentials unreadable.
N8N_ENCRYPTION_KEY=your_random_key_here

N8N_PORT=5679
